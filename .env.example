# Aucun secret ne doit être défini ici. L'URL et le jeton Home Assistant sont saisis localement pendant l'onboarding.
VITE_APP_VERSION=0.1.0
# Client ID de l'application Spotify (public : le flux PKCE ne demande aucun secret).
# Copiez-le dans un fichier .env.local, ou saisissez-le directement dans Réglages.
VITE_SPOTIFY_CLIENT_ID=
